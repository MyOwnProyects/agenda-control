<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agenda activa - Axolotl</title>

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Fonts / Icons (conservados del original) -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">

<style>
:root{
  --clr-primary:#3525cd;
  --clr-primary-fixed:#e2dfff;
  --clr-primary-fixed-dim:#c3c0ff;
  --clr-on-primary:#ffffff;
  --clr-on-primary-fixed-variant:#3323cc;
  --clr-secondary:#006591;
  --clr-secondary-container:#39b8fd;
  --clr-secondary-fixed:#c9e6ff;
  --clr-secondary-fixed-dim:#89ceff;
  --clr-tertiary:#95002b;
  --clr-tertiary-fixed:#ffdadb;
  --clr-tertiary-fixed-dim:#ffb2b7;
  --clr-tertiary-container:#bf0f3c;
  --clr-background:#faf8ff;
  --clr-surface:#faf8ff;
  --clr-surface-container-lowest:#ffffff;
  --clr-surface-container-low:#f2f3ff;
  --clr-surface-container:#eaedff;
  --clr-surface-container-high:#e2e7ff;
  --clr-surface-container-highest:#dae2fd;
  --clr-surface-variant:#dae2fd;
  --clr-on-surface:#131b2e;
  --clr-on-surface-variant:#464555;
  --clr-outline:#777587;
  --clr-outline-variant:#c7c4d8;
}
body{
  background-color:var(--clr-background);
  color:var(--clr-on-surface);
  font-family:'Inter',sans-serif;
  font-size:13px;
}
.font-headline{font-family:'Plus Jakarta Sans',sans-serif;}
.font-mono{font-family:'JetBrains Mono',monospace; font-size:11px;}
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 20; vertical-align:middle;}

/* ---- Utility color classes (mapeo de tokens del diseño original) ---- */
.bg-brand-primary{background-color:var(--clr-primary)!important;}
.text-brand-primary{color:var(--clr-primary)!important;}
.bg-brand-primary-fixed{background-color:var(--clr-primary-fixed)!important;}
.text-on-primary-fixed-variant{color:var(--clr-on-primary-fixed-variant)!important;}
.bg-brand-secondary{background-color:var(--clr-secondary)!important;}
.text-brand-secondary{color:var(--clr-secondary)!important;}
.bg-secondary-fixed{background-color:var(--clr-secondary-fixed)!important;}
.bg-brand-tertiary{background-color:var(--clr-tertiary)!important;}
.text-brand-tertiary{color:var(--clr-tertiary)!important;}
.bg-tertiary-fixed{background-color:var(--clr-tertiary-fixed)!important;}
.bg-tertiary-fixed-dim{background-color:var(--clr-tertiary-fixed-dim)!important;}
.text-on-surface-variant{color:var(--clr-on-surface-variant)!important;}
.text-outline{color:var(--clr-outline)!important;}
.text-outline-variant{color:var(--clr-outline-variant)!important;}
.bg-surface-lowest{background-color:var(--clr-surface-container-lowest)!important;}
.bg-surface-low{background-color:var(--clr-surface-container-low)!important;}
.bg-surface-high{background-color:var(--clr-surface-container-high)!important;}
.bg-surface-variant{background-color:var(--clr-surface-variant)!important;}

/* ---- Layout shell ---- */
.app-main{ padding:1.5rem; min-height:100vh;}

/* Chips / pills */
.chip{border-radius:999px; font-size:11px; font-weight:600; padding:.15rem .6rem;}

/* Calendar cells */
.slot-cell{border-radius:.5rem; padding:.35rem; height:100%; cursor:pointer; transition:box-shadow .15s ease;}
.slot-cell:hover{box-shadow:0 1px 4px rgba(0,0,0,.08);}
.slot-empty{background-color:var(--clr-surface-container-low); display:flex; align-items:center; justify-content:center; color:var(--clr-outline-variant);}
.slot-empty:hover{background-color:var(--clr-surface-container); color:var(--clr-primary);}
.slot-blocked{background-color:rgba(226,231,255,.5); color:var(--clr-outline); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.15rem; opacity:.8;}
.table-agenda td, .table-agenda th{vertical-align:middle;}
.table-agenda{table-layout:fixed;}
.table-agenda th{background-color:var(--clr-surface-container-lowest);}

/* Legend swatch */
.swatch{width:12px; height:12px; border-radius:50%; display:inline-block;}
</style>
</head>

<body>

<!-- ===================== MAIN ===================== -->
<main class="app-main">

  <!-- ---- Top strip: navegación + acciones ---- -->
  <div class="bg-surface-lowest rounded-3 shadow-sm p-3 d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-3">
    <div class="d-flex flex-wrap align-items-center gap-3">
      <div class="d-flex align-items-center gap-1 bg-surface-low p-1 rounded-3">
        <button class="btn btn-sm p-0 d-flex align-items-center justify-content-center" style="width:32px;height:32px;" aria-label="Semana anterior">
          <span class="material-symbols-outlined" style="font-size:18px;">chevron_left</span>
        </button>
        <button class="btn btn-light btn-sm fw-semibold shadow-sm" type="button">Hoy</button>
        <button class="btn btn-sm p-0 d-flex align-items-center justify-content-center" style="width:32px;height:32px;" aria-label="Semana siguiente">
          <span class="material-symbols-outlined" style="font-size:18px;">chevron_right</span>
        </button>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="material-symbols-outlined text-brand-primary" style="font-size:22px;">calendar_month</span>
        <span class="font-headline fw-semibold" style="font-size:18px;">Semana 39: 21 al 27 de Septiembre, 2026</span>
        <span class="chip bg-brand-secondary bg-opacity-10 text-brand-secondary text-uppercase">Activa</span>
      </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3">
      <div class="d-flex align-items-center bg-surface-low p-1 rounded-3">
        <button class="btn btn-sm text-on-surface-variant" type="button">Día</button>
        <button class="btn btn-sm bg-brand-primary text-white shadow-sm" type="button">Semana</button>
        <button class="btn btn-sm text-on-surface-variant" type="button">Mes</button>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button class="btn bg-surface-high d-flex align-items-center gap-2" type="button">
          <span class="material-symbols-outlined text-brand-tertiary" style="font-size:18px;">warning</span>
          <span class="fw-semibold small">Fuera de horario</span>
          <span class="badge rounded-pill bg-brand-tertiary">1</span>
        </button>
        <button class="btn bg-brand-primary text-white d-flex align-items-center gap-2 shadow" type="button">
          <span class="material-symbols-outlined" style="font-size:20px;">add</span>
          <span class="fw-semibold small">Nueva Cita</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ---- Workspace: panel + grid ---- -->
  <div class="row g-3 align-items-start">

    <!-- Panel lateral -->
    <div class="col-lg-3 d-flex flex-column gap-3">

      <!-- Mini calendario -->
      <div class="bg-surface-lowest rounded-3 shadow-sm p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <span class="fw-semibold small">Septiembre 2026</span>
          <div class="d-flex gap-1">
            <button class="btn btn-sm p-0 d-flex align-items-center justify-content-center" style="width:24px;height:24px;" aria-label="Mes anterior"><span class="material-symbols-outlined" style="font-size:16px;">chevron_left</span></button>
            <button class="btn btn-sm p-0 d-flex align-items-center justify-content-center" style="width:24px;height:24px;" aria-label="Mes siguiente"><span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span></button>
          </div>
        </div>
        <div class="row row-cols-7 g-0 text-center text-on-surface-variant small mb-2">
          <div class="col">Lu</div><div class="col">Ma</div><div class="col">Mi</div><div class="col">Ju</div><div class="col">Vi</div><div class="col">Sá</div><div class="col">Do</div>
        </div>
        <div class="row row-cols-7 g-1 text-center font-mono">
          <div class="col py-1 text-outline-variant">31</div>
          <div class="col py-1 text-on-surface-variant">1</div>
          <div class="col py-1 text-on-surface-variant">2</div>
          <div class="col py-1 text-on-surface-variant">3</div>
          <div class="col py-1 text-on-surface-variant">4</div>
          <div class="col py-1 text-outline-variant">5</div>
          <div class="col py-1 text-outline-variant">6</div>
          <div class="col py-1 text-on-surface-variant">7</div>
          <div class="col py-1 text-on-surface-variant">8</div>
          <div class="col py-1 text-on-surface-variant">9</div>
          <div class="col py-1 text-on-surface-variant">10</div>
          <div class="col py-1 text-on-surface-variant">11</div>
          <div class="col py-1 text-outline-variant">12</div>
          <div class="col py-1 text-outline-variant">13</div>
          <div class="col py-1 text-on-surface-variant">14</div>
          <div class="col py-1 text-on-surface-variant">15</div>
          <div class="col py-1 text-on-surface-variant">16</div>
          <div class="col py-1 text-on-surface-variant">17</div>
          <div class="col py-1 text-on-surface-variant">18</div>
          <div class="col py-1 text-outline-variant">19</div>
          <div class="col py-1 text-outline-variant">20</div>
          <div class="col-12">
            <div class="row row-cols-7 g-0 py-1">
              <div class="col text-brand-primary fw-bold">21</div>
              <div class="col text-brand-primary fw-bold">22</div>
              <div class="col"><span class="bg-brand-primary text-white rounded fw-bold px-1 shadow-sm">23</span></div>
              <div class="col text-brand-primary fw-bold">24</div>
              <div class="col text-brand-primary fw-bold">25</div>
              <div class="col text-outline-variant fw-medium">26</div>
              <div class="col text-outline-variant fw-medium">27</div>
            </div>
          </div>
          <div class="col py-1 text-on-surface-variant">28</div>
          <div class="col py-1 text-on-surface-variant">29</div>
          <div class="col py-1 text-on-surface-variant">30</div>
          <div class="col py-1 text-outline-variant">1</div>
          <div class="col py-1 text-outline-variant">2</div>
          <div class="col py-1 text-outline-variant">3</div>
          <div class="col py-1 text-outline-variant">4</div>
        </div>
      </div>

      <!-- Filtros -->
      <div class="bg-surface-lowest rounded-3 shadow-sm p-3 d-flex flex-column gap-3">
        <div class="d-flex align-items-center justify-content-between border-bottom pb-2">
          <span class="font-headline fw-semibold" style="font-size:15px;">Filtros de Agenda</span>
          <button class="btn btn-link btn-sm text-brand-primary text-decoration-none p-0" type="button">Reestablecer</button>
        </div>

        <div>
          <label class="form-label small text-on-surface-variant mb-1">Sede Clínica</label>
          <div class="d-flex align-items-center justify-content-between bg-surface-low px-3 py-2 rounded-3" style="cursor:pointer;">
            <div class="d-flex align-items-center gap-2">
              <span class="material-symbols-outlined text-brand-secondary" style="font-size:18px;">apartment</span>
              <span class="fw-semibold small">Axolotl - Principal</span>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant" style="font-size:18px;">expand_more</span>
          </div>
        </div>

        <div>
          <label class="form-label small text-on-surface-variant mb-1">Especialistas asignados</label>
          <div class="d-flex flex-column gap-1">
            <label class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-surface-low" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2">
                <input class="form-check-input mt-0" type="checkbox" checked>
                <span class="small">Alvarez B. Yamileth</span>
              </div>
              <span class="swatch bg-brand-secondary"></span>
            </label>
            <label class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-surface-low" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2">
                <input class="form-check-input mt-0" type="checkbox" checked>
                <span class="small">Gastélum V. Mónica B.</span>
              </div>
              <span class="swatch" style="background-color:var(--clr-tertiary-container);"></span>
            </label>
            <label class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-surface-low" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2">
                <input class="form-check-input mt-0" type="checkbox" checked>
                <span class="small">Villarreal G. Sarahí</span>
              </div>
              <span class="swatch bg-brand-primary"></span>
            </label>
          </div>
        </div>

        <div>
          <label class="form-label small text-on-surface-variant mb-2">Código de Especialidad</label>
          <div class="d-flex flex-column gap-1">
            <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2"><span class="swatch bg-brand-secondary"></span><span class="small">Conducta</span></div>
              <span class="font-mono text-on-surface-variant">11</span>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2"><span class="swatch" style="background-color:var(--clr-primary-fixed-dim);"></span><span class="small">Integral</span></div>
              <span class="font-mono text-on-surface-variant">14</span>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2"><span class="swatch" style="background-color:var(--clr-tertiary-fixed-dim);"></span><span class="small">Integral nuevo</span></div>
              <span class="font-mono text-on-surface-variant">5</span>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2"><span class="swatch bg-secondary-fixed-dim" style="background-color:var(--clr-secondary-fixed-dim);"></span><span class="small">Lenguaje</span></div>
              <span class="font-mono text-on-surface-variant">7</span>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2"><span class="swatch bg-surface-variant"></span><span class="small">Nivelación Académica</span></div>
              <span class="font-mono text-on-surface-variant">3</span>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2" style="cursor:pointer;">
              <div class="d-flex align-items-center gap-2"><span class="swatch bg-tertiary-fixed"></span><span class="small">Valoración</span></div>
              <span class="font-mono text-on-surface-variant">2</span>
            </div>
          </div>
        </div>

        <div class="p-2 bg-tertiary-fixed bg-opacity-50 rounded-3 d-flex align-items-center gap-2">
          <span class="material-symbols-outlined text-brand-tertiary" style="font-size:20px;">error</span>
          <span class="small">Falta Pago: 6 citas requieren liquidación</span>
        </div>
      </div>
    </div>

    <!-- Grid principal de calendario -->
    <div class="col-lg-9 d-flex flex-column gap-3">

      <!-- TURNO MATUTINO -->
      <div class="bg-surface-lowest rounded-3 shadow-sm overflow-hidden">
        <div class="bg-surface-low px-3 py-2 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-2">
            <span class="d-flex align-items-center justify-content-center rounded-2 bg-surface-high text-brand-primary" style="width:28px;height:28px;">
              <span class="material-symbols-outlined" style="font-size:18px;">wb_sunny</span>
            </span>
            <div>
              <span class="font-headline fw-semibold" style="font-size:15px;">Turno Matutino</span>
              <span class="font-mono text-on-surface-variant ms-2">09:00 - 12:45</span>
            </div>
          </div>
          <span class="chip bg-surface-lowest shadow-sm">18 Citas Asignadas</span>
        </div>

        <div class="table-responsive">
          <table class="table table-agenda mb-0" style="min-width:760px;">
            <thead>
              <tr class="text-on-surface-variant">
                <th class="text-center small bg-surface-low" style="width:96px;">Hora</th>
                <th class="small">21/sept. <span class="text-on-surface-variant fw-normal d-block">Lunes</span></th>
                <th class="small">22/sept. <span class="text-on-surface-variant fw-normal d-block">Martes</span></th>
                <th class="small bg-brand-primary-fixed bg-opacity-20 text-brand-primary">23/sept. <span class="fw-normal d-block">Miércoles</span></th>
                <th class="small">24/sept. <span class="text-on-surface-variant fw-normal d-block">Jueves</span></th>
                <th class="small">25/sept. <span class="text-on-surface-variant fw-normal d-block">Viernes</span></th>
                <th class="text-center small bg-surface-high text-outline" style="width:112px;">26/Sáb.</th>
                <th class="text-center small bg-surface-high text-outline" style="width:112px;">27/Dom.</th>
              </tr>
            </thead>
            <tbody class="small">
              <!-- Slot 09:00 - 09:45 -->
              <tr style="height:64px;">
                <td class="text-center font-mono bg-surface-low text-on-surface-variant">09:00<br><span style="font-size:10px;" class="text-outline">09:45</span></td>
                <td class="p-1">
                  <div class="slot-cell" style="background-color:rgba(137,206,255,.4);">
                    <div class="fw-semibold text-truncate">Curiel V. Ian Tadeo</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="font-mono text-brand-secondary" style="font-size:10px;">Lenguaje (4.10)</span>
                      <span class="material-symbols-outlined text-brand-primary" style="font-size:13px;">check_circle</span>
                    </div>
                  </div>
                </td>
                <td class="p-1"><div class="slot-cell slot-empty"><span class="material-symbols-outlined" style="font-size:18px;">add_circle_outline</span></div></td>
                <td class="p-1 bg-brand-primary-fixed bg-opacity-10">
                  <div class="slot-cell" style="background-color:rgba(195,192,255,.6);">
                    <div class="fw-semibold text-truncate">Benítez C. Carlos Alan</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="font-mono text-on-primary-fixed-variant" style="font-size:10px;">Integral (5.11)</span>
                      <span class="material-symbols-outlined text-brand-tertiary" style="font-size:14px;" title="Falta Pago">error</span>
                    </div>
                  </div>
                </td>
                <td class="p-1">
                  <div class="slot-cell" style="background-color:rgba(137,206,255,.4);">
                    <div class="fw-semibold text-truncate">Vargas G. Sofía</div>
                    <span class="font-mono text-brand-secondary" style="font-size:10px;">Lenguaje (6.02)</span>
                  </div>
                </td>
                <td class="p-1"><div class="slot-cell slot-empty"><span class="material-symbols-outlined" style="font-size:18px;">add_circle_outline</span></div></td>
                <td class="slot-blocked" rowspan="5"><span class="material-symbols-outlined" style="font-size:20px;">block</span><span style="font-size:11px;">Horario no disponible</span></td>
                <td class="slot-blocked" rowspan="5"><span class="material-symbols-outlined" style="font-size:20px;">block</span><span style="font-size:11px;">Horario no disponible</span></td>
              </tr>
              <!-- Slot 09:45 - 10:30 -->
              <tr style="height:64px;">
                <td class="text-center font-mono bg-surface-low text-on-surface-variant">09:45<br><span style="font-size:10px;" class="text-outline">10:30</span></td>
                <td class="p-1">
                  <div class="slot-cell" style="background-color:rgba(0,101,145,.15);">
                    <div class="fw-semibold text-truncate">Méndez O. Luciana</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="font-mono text-brand-secondary" style="font-size:10px;">Conducta (9.02)</span>
                      <span class="material-symbols-outlined text-brand-primary" style="font-size:13px;">check_circle</span>
                    </div>
                  </div>
                </td>
                <td class="p-1">
                  <div class="slot-cell" style="background-color:rgba(195,192,255,.6);">
                    <div class="fw-semibold text-truncate">Morales A. Diego</div>
                    <span class="font-mono text-on-primary-fixed-variant" style="font-size:10px;">Integral (7.00)</span>
                  </div>
                </td>
                <td class="p-1 bg-brand-primary-fixed bg-opacity-10">
                  <div class="slot-cell" style="background-color:rgba(255,178,183,.6);">
                    <div class="fw-semibold text-truncate">Rodríguez M. Renata</div>
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="font-mono text-brand-tertiary" style="font-size:10px;">Valoración (S/E)</span>
                      <span class="material-symbols-outlined text-brand-tertiary" style="font-size:14px;" title="Falta Pago">error</span>
                    </div>
                  </div>
                </td>
                <td class="p-1"><div class="slot-cell slot-empty"><span class="material-symbols-outlined" style="font-size:18px;">add_circle_outline</span></div></td>
                <td class="p-1">
                  <div class="slot-cell" style="background-color:rgba(137,206,255,.4);">
                    <div class="fw-semibold text-truncate">Beltrán C. Mateo</div>
                    <span class="font-mono text-brand-secondary" style="font-size:10px;">Lenguaje (3.11)</span>
                  </div>
                </td>
              </tr>
              <!-- Slot 10:30 - 11:15 -->
              <tr style="height:64px;">
                <td class="text-center font-mono bg-surface-low text-on-surface-variant">10:30<br><span style="font-size:10px;" class="text-outline">11:15</span></td>
                <td class="p-1"><div class="slot-cell slot-empty"><span class="material-symbols-outlined" style="font-size:18px;">add_circle_outline</span></div></td>
